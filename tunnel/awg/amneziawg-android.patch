+// LodestarVPN: the sorter's direct sockets go past the VPN - the service protects each one
+// (jni.c, GoBackend.awgSetProtector); a socket it could not protect is not used.
+func init() {
+	sorter.SetDialControl(func(network, address string, c syscall.RawConn) error {
+		var ok C.int
+		if err := c.Control(func(fd uintptr) { ok = C.lodestarProtect(C.int(fd)) }); err != nil {
+			return err
+		}
+		if ok == 0 {
+			return errors.New("the socket could not be kept out of the VPN")
+		}
+		return nil
+	})
+}
