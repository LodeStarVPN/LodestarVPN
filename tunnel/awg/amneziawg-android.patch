+/* LodestarVPN: the sorter's direct sockets (amneziawg-go/sorter: connections the app sends past
+ * the VPN) are kept out of the VPN by the service that runs the tunnel - an object with
+ * "boolean protect(int)", given before the tunnel starts. The lock is held through each call,
+ * so a protector replaced meanwhile is never used after it is released. */
+static JavaVM *java_vm;
+static jobject protector;
+static jmethodID protect_method;
+static pthread_mutex_t protector_lock = PTHREAD_MUTEX_INITIALIZER;
+
+JNIEXPORT jint JNI_OnLoad(JavaVM *vm, void *reserved)
+{
+	java_vm = vm;
+	return JNI_VERSION_1_6;
+}
+
+JNIEXPORT void JNICALL Java_org_amnezia_awg_GoBackend_awgSetProtector(JNIEnv *env, jclass c, jobject p)
+{
+	jobject ref = NULL, old;
+	jmethodID method = NULL;
+	if (p) {
+		jclass cls = (*env)->GetObjectClass(env, p);
+		method = (*env)->GetMethodID(env, cls, "protect", "(I)Z");
+		(*env)->DeleteLocalRef(env, cls);
+		if (!method) {
+			(*env)->ExceptionClear(env);
+			return;
+		}
+		ref = (*env)->NewGlobalRef(env, p);
+	}
+	pthread_mutex_lock(&protector_lock);
+	old = protector;
+	protector = ref;
+	protect_method = method;
+	pthread_mutex_unlock(&protector_lock);
+	if (old)
+		(*env)->DeleteGlobalRef(env, old);
+}
+
+/* Called by Go for each direct socket: 1 when it is kept out of the VPN. */
+int lodestarProtect(int fd)
+{
+	JNIEnv *env = NULL;
+	int attached = 0, ok = 0;
+	if (!java_vm)
+		return 0;
+	pthread_mutex_lock(&protector_lock);
+	if (!protector)
+		goto out;
+	if ((*java_vm)->GetEnv(java_vm, (void **)&env, JNI_VERSION_1_6) == JNI_EDETACHED) {
+		if ((*java_vm)->AttachCurrentThread(java_vm, &env, NULL) != JNI_OK)
+			goto out;
+		attached = 1;
+	}
+	ok = (*env)->CallBooleanMethod(env, protector, protect_method, (jint)fd) ? 1 : 0;
+	if ((*env)->ExceptionCheck(env)) {
+		(*env)->ExceptionClear(env);
+		ok = 0;
+	}
+	if (attached)
+		(*java_vm)->DetachCurrentThread(java_vm);
+out:
+	pthread_mutex_unlock(&protector_lock);
+	return ok;
+}
