+
+package sorter
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+)
+
+const testMTU = 1280
+
+var (
+	siteDirect = netip.MustParseAddr("192.0.2.10")  // in the test's networks (TEST-NET-1)
+	siteOther  = netip.MustParseAddr("192.0.2.11")  // in them too
+	siteAbroad = netip.MustParseAddr("192.0.2.200") // not in them
+)
+
+// rig: a second gVisor stack plays the apps of the device; what it sends goes through the
+// device's read path (the sorter takes its packets, the rest "go to the peer" and are counted),
+// and what the sorter writes into the tunnel device reaches it. Direct sockets go to local
+// servers instead of the far sides.
+type rig struct {
+	t        *testing.T
+	sorter   *Sorter
+	apps     *stack.Stack
+	appsEP   *channel.Endpoint
+	toPeer   atomic.Int64
+	cancel   context.CancelFunc
+	listener net.Listener
+	udpConn  net.PacketConn
+	silent   net.PacketConn // a UDP site that never answers
+	refused  atomic.Bool    // direct sockets fail at once
+	noAnswer atomic.Bool    // direct TCP sockets wait for an answer that never comes
+	quietUDP atomic.Bool    // direct UDP sockets go to the silent site
+	dials    atomic.Int64   // direct sockets the sorter asked for
+	sites    atomic.Int64   // TCP connections the site has open
+}
+
+func newRig(t *testing.T) *rig {
+	t.Helper()
+	r := &rig{t: t}
+
+	// the sites: a TCP echo and a UDP echo on this machine
+	var err error
+	r.listener, err = net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		for {
+			c, err := r.listener.Accept()
+			if err != nil {
+				return
+			}
+			r.sites.Add(1)
+			go func() {
+				defer r.sites.Add(-1)
+				io.Copy(c, c)
+				c.(*net.TCPConn).CloseWrite()
+				c.Close()
+			}()
+		}
+	}()
+	r.udpConn, err = net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		b := make([]byte, 65536)
+		for {
+			n, from, err := r.udpConn.ReadFrom(b)
+			if err != nil {
+				return
+			}
+			r.udpConn.WriteTo(append([]byte("echo:"), b[:n]...), from)
+		}
+	}()
+	r.silent, err = net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tcpSite := r.listener.Addr().String()
+	udpSite := r.udpConn.LocalAddr().String()
+	silentSite := r.silent.LocalAddr().String()
+	dial = func(ctx context.Context, network, address string) (net.Conn, error) {
+		r.dials.Add(1)
+		if r.refused.Load() {
+			return nil, errors.New("refused by the test")
+		}
+		var d net.Dialer
+		if strings.HasPrefix(network, "udp") {
+			if r.quietUDP.Load() {
+				return d.DialContext(ctx, network, silentSite)
+			}
+			return d.DialContext(ctx, network, udpSite)
+		}
+		if r.noAnswer.Load() {
+			<-ctx.Done()
+			return nil, ctx.Err()
+		}
+		return d.DialContext(ctx, network, tcpSite)
+	}
+
+	// the apps
+	r.apps = stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol, udp.NewProtocol},
+	})
+	r.appsEP = channel.New(1024, testMTU, "")
+	if err := r.apps.CreateNIC(1, r.appsEP); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.apps.AddProtocolAddress(1, tcpip.ProtocolAddress{
+		Protocol:          ipv4.ProtocolNumber,
+		AddressWithPrefix: tcpip.AddrFrom4([4]byte{10, 7, 0, 2}).WithPrefix(),
+	}, stack.AddressProperties{}); err != nil {
+		t.Fatal(err)
+	}
+	r.apps.AddRoute(tcpip.Route{Destination: header.IPv4EmptySubnet, NIC: 1})
+
+	// the sorter, writing into "the tunnel device": the apps' stack
+	const offset = 16
+	r.sorter, err = New(func(bufs [][]byte, off int) (int, error) {
+		if off != offset {
+			t.Errorf("offset %d, want %d", off, offset)
+		}
+		for _, b := range bufs {
+			pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(b[off:])})
+			r.appsEP.InjectInbound(header.IPv4ProtocolNumber, pkt)
+			pkt.DecRef()
+		}
+		return len(bufs), nil
+	}, offset, testMTU, t.Logf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.sorter.SetNetworks(NewSet([]netip.Prefix{netip.MustParsePrefix("192.0.2.0/25")}))
+
+	// the device's read path: what the apps send
+	var ctx context.Context
+	ctx, r.cancel = context.WithCancel(context.Background())
+	go func() {
+		for {
+			pkt := r.appsEP.ReadContext(ctx)
+			if pkt.IsNil() {
+				return
+			}
+			b := pkt.ToView().AsSlice()
+			pkt.DecRef()
+			if r.sorter.Takes(b) {
+				r.sorter.Deliver(b)
+			} else {
+				r.toPeer.Add(1)
+			}
+		}
+	}()
+	t.Cleanup(r.close)
+	return r
+}
+
+func (r *rig) close() {
+	r.cancel()
+	r.sorter.Close()
+	r.apps.Close()
+	r.listener.Close()
+	r.udpConn.Close()
+	r.silent.Close()
+}
+
+func (r *rig) dialTCP(to netip.Addr, port uint16) (*gonet.TCPConn, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	return gonet.DialContextTCP(ctx, r.apps, fullAddr(to, port), ipv4.ProtocolNumber)
+}
+
+// tryTCP lets an app try a connection that is not to open directly, until the sorter has given
+// it up
+func (r *rig) tryTCP(to netip.Addr, port uint16) {
+	failed := r.sorter.failed.Load()
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		if c, err := gonet.DialContextTCP(ctx, r.apps, fullAddr(to, port), ipv4.ProtocolNumber); err == nil {
+			c.Close()
+		}
+	}()
+	ok := r.waitFor(func() bool { return r.sorter.failed.Load() > failed })
+	cancel() // the app gives up: no more SYNs of it
+	<-done
+	if !ok {
+		r.t.Fatalf("%v:%d: the sorter did not give the connection up", to, port)
+	}
+}
+
+// waitFor waits up to 3 s for cond
+func (r *rig) waitFor(cond func() bool) bool {
+	for deadline := time.Now().Add(3 * time.Second); !cond(); {
+		if time.Now().After(deadline) {
+			return false
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	return true
+}
+
+func fullAddr(to netip.Addr, port uint16) tcpip.FullAddress {
+	return tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFrom4(to.As4()), Port: port}
+}
+
+// siteN is the n-th of some more addresses in the test's networks
+func siteN(n int) netip.Addr {
+	return netip.AddrFrom4([4]byte{192, 0, 2, byte(20 + n)})
+}
+
+// synTo and udpTo are the first packets of an app's new TCP connection and UDP flow
+func synTo(to netip.Addr, port uint16) []byte {
+	b := appPacket(6, to, port, 40)
+	b[20+12] = 5 << 4 // data offset
+	b[20+13] = 0x02   // SYN
+	return b
+}
+
+func udpTo(to netip.Addr, port uint16) []byte {
+	return appPacket(17, to, port, 28)
+}
+
+func appPacket(proto byte, to netip.Addr, port uint16, size int) []byte {
+	b := make([]byte, size)
+	b[0] = 0x45
+	b[9] = proto
+	copy(b[12:16], []byte{10, 7, 0, 2})
+	d := to.As4()
+	copy(b[16:20], d[:])
+	b[20], b[21] = 0x9c, 0x40 // the app's port 40000
+	b[22], b[23] = byte(port>>8), byte(port)
+	return b
+}
+
+func TestSetContains(t *testing.T) {
+	s := NewSet([]netip.Prefix{
+		netip.MustParsePrefix("10.0.0.0/9"),
+		netip.MustParsePrefix("10.1.0.0/16"),  // inside the first
+		netip.MustParsePrefix("10.128.0.0/9"), // right after it: one range
+		netip.MustParsePrefix("192.168.1.0/24"),
+		netip.MustParsePrefix("2001:db8::/32"), // not IPv4: left out
+		netip.MustParsePrefix("0.0.0.0/32"),
+		netip.MustParsePrefix("255.255.255.255/32"),
+	})
+	if s.Len() != 4 {
+		t.Fatalf("ranges: %d, want 4", s.Len())
+	}
+	for _, c := range []struct {
+		ip   string
+		want bool
+	}{
+		{"10.0.0.0", true}, {"10.255.255.255", true}, {"9.255.255.255", false}, {"11.0.0.0", false},
+		{"192.168.1.77", true}, {"192.168.2.1", false}, {"0.0.0.0", true}, {"0.0.0.1", false},
+		{"255.255.255.255", true}, {"255.255.255.254", false},
+	} {
+		a := netip.MustParseAddr(c.ip).As4()
+		if got := s.Contains(a[:]); got != c.want {
+			t.Errorf("%s: %v, want %v", c.ip, got, c.want)
+		}
+	}
+	if NewSet(nil).Contains([]byte{1, 2, 3, 4}) {
+		t.Error("an empty set holds an address")
+	}
+}
+
+func TestTakes(t *testing.T) {
+	s := &Sorter{}
+	s.SetNetworks(NewSet([]netip.Prefix{netip.MustParsePrefix("192.0.2.0/25")}))
+	packet := func(proto byte, dst netip.Addr) []byte {
+		b := make([]byte, 40)
+		b[0] = 0x45
+		b[9] = proto
+		d := dst.As4()
+		copy(b[16:20], d[:])
+		return b
+	}
+	if !s.Takes(packet(6, siteDirect)) || !s.Takes(packet(17, siteDirect)) {
+		t.Error("TCP or UDP to the networks is not taken")
+	}
+	if s.Takes(packet(1, siteDirect)) {
+		t.Error("ICMP is taken: a ping must go to the peer")
+	}
+	if s.Takes(packet(6, siteAbroad)) {
+		t.Error("an address outside the networks is taken")
+	}
+	if s.Takes(packet(6, siteDirect)[:19]) {
+		t.Error("a packet shorter than an IPv4 header is taken")
+	}
+}
+
+func TestTCP(t *testing.T) {
+	r := newRig(t)
+	c, err := r.dialTCP(siteDirect, 443)
+	if err != nil {
+		t.Fatalf("connect: %v", err)
+	}
+	defer c.Close()
+	msg := []byte("hello through the sorter")
+	if _, err := c.Write(msg); err != nil {
+		t.Fatal(err)
+	}
+	got := make([]byte, len(msg))
+	c.SetReadDeadline(time.Now().Add(5 * time.Second))
+	if _, err := io.ReadFull(c, got); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, msg) {
+		t.Fatalf("echo %q, want %q", got, msg)
+	}
+	// the app finishes: the site finishes too, and the app sees the end
+	c.CloseWrite()
+	if n, err := c.Read(got); err != io.EOF {
+		t.Fatalf("after the end: %d bytes, %v", n, err)
+	}
+	if r.toPeer.Load() != 0 {
+		t.Errorf("%d packets went to the peer", r.toPeer.Load())
+	}
+}
+
+func TestTCPBulk(t *testing.T) {
+	r := newRig(t)
+	c, err := r.dialTCP(siteDirect, 80)
+	if err != nil {
+		t.Fatalf("connect: %v", err)
+	}
+	defer c.Close()
+	const size = 32 << 20
+	data := make([]byte, size)
+	rand.Read(data)
+	want := sha256.Sum256(data)
+	start := time.Now()
+	go func() {
+		c.Write(data)
+		c.CloseWrite()
+	}()
+	h := sha256.New()
+	c.SetReadDeadline(time.Now().Add(60 * time.Second))
+	n, err := io.Copy(h, c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	elapsed := time.Since(start)
+	if n != size || !bytes.Equal(h.Sum(nil), want[:]) {
+		t.Fatalf("%d bytes back, the same: %v", n, bytes.Equal(h.Sum(nil), want[:]))
+	}
+	t.Logf("32 MB there and back in %v (%.0f Mbit/s each way)", elapsed, float64(size)*8/elapsed.Seconds()/1e6)
+	// the data each way, each byte once (not the packets: what the stack sends again is not counted)
+	if rx, tx := r.sorter.Bytes(); rx != size || tx != size {
+		t.Errorf("counted %d bytes from the site and %d to it for %d each way", rx, tx, size)
+	}
+}
+
+// a connection that does not open directly gets no answer from the sorter: the app sends its
+// SYN again, and that one goes to the peer, as do new connections to that address; the other
+// addresses still open directly
+func TestTCPNotOpenedGoesThroughVPN(t *testing.T) {
+	r := newRig(t)
+	r.refused.Store(true)
+	start := time.Now()
+	ctx, cancel := context.WithTimeout(context.Background(), 1800*time.Millisecond)
+	defer cancel()
+	c, err := gonet.DialContextTCP(ctx, r.apps, fullAddr(siteDirect, 443), ipv4.ProtocolNumber)
+	if err == nil {
+		c.Close()
+		t.Fatal("a site that did not open directly was answered by the sorter")
+	}
+	if elapsed := time.Since(start); elapsed < 1500*time.Millisecond {
+		t.Fatalf("the app learned in %v (%v): the sorter reset it instead of letting its SYN go through the VPN", elapsed, err)
+	}
+	if r.toPeer.Load() == 0 {
+		t.Error("the app's next SYN did not go to the peer")
+	}
+	if r.dials.Load() != 1 {
+		t.Errorf("%d direct sockets asked for, want 1", r.dials.Load())
+	}
+	if r.sorter.Takes(synTo(siteDirect, 443)) || r.sorter.Takes(synTo(siteDirect, 80)) {
+		t.Error("a new connection to that address is taken")
+	}
+	if !r.sorter.Takes(synTo(siteOther, 443)) {
+		t.Error("a connection to another address is not taken")
+	}
+	r.refused.Store(false)
+	c, err = r.dialTCP(siteOther, 443)
+	if err != nil {
+		t.Fatalf("another address: %v", err)
+	}
+	c.Close()
+	if r.sorter.failed.Load() != 1 || r.sorter.viaVPN.Load() == 0 {
+		t.Errorf("did not open %d, through the VPN %d", r.sorter.failed.Load(), r.sorter.viaVPN.Load())
+	}
+}
+
+// a site that does not answer at all: past openTimeout the same
+func TestTCPNoAnswerGoesThroughVPN(t *testing.T) {
+	defer func(d time.Duration) { openTimeout = d }(openTimeout)
+	openTimeout = 300 * time.Millisecond
+	r := newRig(t)
+	r.noAnswer.Store(true)
+	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
+	defer cancel()
+	if c, err := gonet.DialContextTCP(ctx, r.apps, fullAddr(siteDirect, 443), ipv4.ProtocolNumber); err == nil {
+		c.Close()
+		t.Fatal("a site that did not answer was answered by the sorter")
+	}
+	if r.toPeer.Load() == 0 {
+		t.Error("the app's next SYN did not go to the peer")
+	}
+	if r.sorter.Takes(synTo(siteDirect, 443)) {
+		t.Error("a new connection to that address is taken")
+	}
+}
+
+// several addresses on one TCP port that do not open, none on it that does: the computer keeps
+// the port from opening directly, and all of it goes through the VPN; other ports do not
+func TestPortGoesThroughVPN(t *testing.T) {
+	r := newRig(t)
+	r.refused.Store(true)
+	for i := 0; i < portFailures; i++ {
+		if !r.sorter.Takes(synTo(siteN(9), 443)) {
+			t.Fatalf("port 443 went through the VPN after %d addresses", i)
+		}
+		r.tryTCP(siteN(i), 443)
+	}
+	if r.sorter.Takes(synTo(siteN(9), 443)) {
+		t.Fatal("port 443 is still taken after addresses on it did not open")
+	}
+	if !r.sorter.Takes(synTo(siteN(9), 80)) {
+		t.Error("port 80 went through the VPN with 443")
+	}
+	if !r.sorter.Takes(udpTo(siteN(9), 443)) {
+		t.Error("UDP to port 443 went through the VPN with TCP")
+	}
+}
+
+// a port on which a connection opened directly stays direct for the other addresses
+func TestPortThatOpenedStays(t *testing.T) {
+	r := newRig(t)
+	c, err := r.dialTCP(siteN(0), 443)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Close()
+	r.refused.Store(true)
+	for i := 1; i <= portFailures; i++ {
+		r.tryTCP(siteN(i), 443)
+	}
+	if !r.sorter.Takes(synTo(siteN(9), 443)) {
+		t.Error("port 443 went through the VPN though a connection on it opened directly")
+	}
+}
+
+// nothing opens directly at all: everything goes through the VPN, UDP too
+func TestEverythingGoesThroughVPN(t *testing.T) {
+	r := newRig(t)
+	r.refused.Store(true)
+	for i, port := range []uint16{443, 80, 8443, 5222, 993} {
+		if !r.sorter.Takes(synTo(siteN(9), 12345)) {
+			t.Fatalf("everything went through the VPN after %d addresses", i)
+		}
+		r.tryTCP(siteN(i), port)
+	}
+	if r.sorter.Takes(synTo(siteN(9), 12345)) {
+		t.Fatal("a new connection is taken after nothing opened directly")
+	}
+	if r.sorter.Takes(udpTo(siteN(9), 53)) {
+		t.Error("UDP is taken after nothing opened directly")
+	}
+	if r.sorter.Takes(synTo(siteAbroad, 443)) {
+		t.Error("an address outside the networks is taken")
+	}
+}
+
+// a connection the sorter carries stays with it when its address goes through the VPN
+func TestCarriedConnectionStays(t *testing.T) {
+	r := newRig(t)
+	c, err := r.dialTCP(siteDirect, 443)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	r.refused.Store(true)
+	r.tryTCP(siteDirect, 443)
+	if r.sorter.Takes(synTo(siteDirect, 443)) {
+		t.Fatal("the address did not go through the VPN")
+	}
+	before := r.toPeer.Load()
+	msg := []byte("still direct")
+	if _, err := c.Write(msg); err != nil {
+		t.Fatal(err)
+	}
+	got := make([]byte, len(msg))
+	c.SetReadDeadline(time.Now().Add(5 * time.Second))
+	if _, err := io.ReadFull(c, got); err != nil || !bytes.Equal(got, msg) {
+		t.Fatalf("echo %q, %v", got, err)
+	}
+	if r.toPeer.Load() != before {
+		t.Errorf("%d packets of the carried connection went to the peer", r.toPeer.Load()-before)
+	}
+}
+
+// a UDP flow the site does not answer ends, and the app's next datagrams go to the peer
+func TestUDPNoAnswerGoesThroughVPN(t *testing.T) {
+	defer func(d time.Duration) { answerTimeout = d }(answerTimeout)
+	answerTimeout = 300 * time.Millisecond
+	r := newRig(t)
+	r.quietUDP.Store(true)
+	c, err := gonet.DialUDP(r.apps, nil, &tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFrom4(siteDirect.As4()), Port: 443}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	c.Write([]byte("initial"))
+	if !r.waitFor(func() bool { return !r.sorter.Takes(udpTo(siteDirect, 443)) }) {
+		t.Fatal("the address did not go through the VPN after the site did not answer")
+	}
+	before := r.toPeer.Load()
+	c.Write([]byte("initial again"))
+	if !r.waitFor(func() bool { return r.toPeer.Load() > before }) {
+		t.Error("the app's next datagram did not go to the peer")
+	}
+	if r.sorter.udpOpened.Load() != 0 || r.sorter.failed.Load() != 1 {
+		t.Errorf("opened %d, did not open %d", r.sorter.udpOpened.Load(), r.sorter.failed.Load())
+	}
+}
+
+func TestTCPAbroadGoesToPeer(t *testing.T) {
+	r := newRig(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
+	defer cancel()
+	_, err := gonet.DialContextTCP(ctx, r.apps, tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFrom4(siteAbroad.As4()), Port: 443}, ipv4.ProtocolNumber)
+	if err == nil {
+		t.Fatal("a site outside the networks was answered by the sorter")
+	}
+	if r.toPeer.Load() == 0 {
+		t.Error("nothing went to the peer")
+	}
+}
+
+func TestUDP(t *testing.T) {
+	r := newRig(t)
+	c, err := gonet.DialUDP(r.apps, nil, &tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFrom4(siteDirect.As4()), Port: 53}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	for i := 0; i < 3; i++ {
+		msg := []byte{'q', byte('0' + i)}
+		if _, err := c.Write(msg); err != nil {
+			t.Fatal(err)
+		}
+		got := make([]byte, 100)
+		c.SetReadDeadline(time.Now().Add(5 * time.Second))
+		n, err := c.Read(got)
+		if err != nil {
+			t.Fatalf("answer %d: %v", i, err)
+		}
+		if want := "echo:" + string(msg); string(got[:n]) != want {
+			t.Fatalf("answer %q, want %q", got[:n], want)
+		}
+	}
+	if r.toPeer.Load() != 0 {
+		t.Errorf("%d packets went to the peer", r.toPeer.Load())
+	}
+}
+
+func TestCloseEndsConnections(t *testing.T) {
+	r := newRig(t)
+	c, err := r.dialTCP(siteDirect, 443)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	c.Write([]byte("x"))
+	got := make([]byte, 1)
+	c.SetReadDeadline(time.Now().Add(5 * time.Second))
+	if _, err := io.ReadFull(c, got); err != nil {
+		t.Fatal(err)
+	}
+	if r.sites.Load() != 1 {
+		t.Fatalf("the site has %d connections, want 1", r.sites.Load())
+	}
+	r.sorter.Close()
+	// the direct socket is closed with the sorter: the site's side ends at once
+	for deadline := time.Now().Add(2 * time.Second); r.sites.Load() != 0; {
+		if time.Now().After(deadline) {
+			t.Fatal("the site's connection lives on after the sorter closed")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+// a port that went through the VPN is tried directly again after retryDirect: one connection
+// that opens brings the whole port back, and it can go through the VPN again just as at the start
+func TestPortTriesDirectAgain(t *testing.T) {
+	defer func(d time.Duration) { retryDirect = d }(retryDirect)
+	retryDirect = 300 * time.Millisecond
+	r := newRig(t)
+	r.refused.Store(true)
+	for i := 0; i < portFailures; i++ {
+		r.tryTCP(siteN(i), 443)
+	}
+	if r.sorter.Takes(synTo(siteN(9), 443)) {
+		t.Fatal("port 443 is taken right after it went through the VPN")
+	}
+	time.Sleep(retryDirect + 50*time.Millisecond)
+	r.refused.Store(false)
+	c, err := r.dialTCP(siteN(8), 443)
+	if err != nil {
+		t.Fatalf("the try directly again: %v", err)
+	}
+	c.Close()
+	if !r.sorter.Takes(synTo(siteN(9), 443)) {
+		t.Error("port 443 still goes through the VPN after a connection on it opened directly again")
+	}
+	if r.sorter.Takes(synTo(siteN(0), 443)) {
+		t.Error("an address that did not open came back with the port")
+	}
+	// the computer keeps the port again: it goes through the VPN after as many addresses
+	r.refused.Store(true)
+	for i := 3; i < 3+portFailures; i++ {
+		r.tryTCP(siteN(i), 443)
+	}
+	if r.sorter.Takes(synTo(siteN(9), 443)) {
+		t.Error("port 443 is taken though addresses on it did not open again")
+	}
+}
+
+// a try directly again that does not open either keeps the port through the VPN for another
+// retryDirect, and only one connection tries at a time
+func TestPortTriedAgainStays(t *testing.T) {
+	defer func(d time.Duration) { retryDirect = d }(retryDirect)
+	retryDirect = 300 * time.Millisecond
+	r := newRig(t)
+	r.refused.Store(true)
+	for i := 0; i < portFailures; i++ {
+		r.tryTCP(siteN(i), 443)
+	}
+	time.Sleep(retryDirect + 50*time.Millisecond)
+	dials := r.dials.Load()
+	r.tryTCP(siteN(8), 443)
+	if r.dials.Load() != dials+1 {
+		t.Fatalf("%d direct sockets for the try again, want 1", r.dials.Load()-dials)
+	}
+	if r.sorter.Takes(synTo(siteN(9), 443)) {
+		t.Error("port 443 is taken after the try directly again did not open")
+	}
+}
+
+// quickHealing makes the tries in the background quick for a test. What it sets goes back when
+// the test and its rig are done (cleanups run last in, first out: call it before newRig),
+// because the sorter reads it from goroutines of its own.
+func quickHealing(t *testing.T) {
+	t.Helper()
+	every, gap := healEvery, maxProbeGap
+	t.Cleanup(func() { healEvery, maxProbeGap = every, gap })
+	healEvery, maxProbeGap = 20*time.Millisecond, 80*time.Millisecond
+}
+
+// an address that did not open comes back by itself once it opens: nobody has to be at a site
+// to try it again
+func TestProbeHealsAddress(t *testing.T) {
+	quickHealing(t)
+	r := newRig(t)
+	r.refused.Store(true)
+	r.tryTCP(siteDirect, 443)
+	if r.sorter.Takes(synTo(siteDirect, 443)) {
+		t.Fatal("the address did not go through the VPN")
+	}
+	if !r.sorter.Takes(synTo(siteOther, 443)) {
+		t.Fatal("another address went through the VPN with it")
+	}
+	r.refused.Store(false)
+	if !r.waitFor(func() bool { return r.sorter.Takes(synTo(siteDirect, 443)) }) {
+		t.Fatal("the address did not come back by itself after it opened")
+	}
+	// and it opens for the app
+	c, err := r.dialTCP(siteDirect, 443)
+	if err != nil {
+		t.Fatalf("connect: %v", err)
+	}
+	c.Close()
+}
+
+// everything went through the VPN, then what kept it from opening is gone: without a single
+// connection of an app everything comes back, the addresses that did not open with it
+func TestProbeHealsEverything(t *testing.T) {
+	quickHealing(t)
+	r := newRig(t)
+	r.refused.Store(true)
+	ports := []uint16{443, 80, 8443, 5222, 993}
+	for i, port := range ports {
+		r.tryTCP(siteN(i), port)
+	}
+	if r.sorter.Takes(synTo(siteN(9), 12345)) {
+		t.Fatal("everything did not go through the VPN")
+	}
+	r.refused.Store(false)
+	if !r.waitFor(func() bool { return r.sorter.Takes(synTo(siteN(9), 12345)) }) {
+		t.Fatal("everything did not come back by itself after it opened")
+	}
+	if !r.waitFor(func() bool {
+		for i, port := range ports {
+			if !r.sorter.Takes(synTo(siteN(i), port)) {
+				return false
+			}
+		}
+		return true
+	}) {
+		t.Error("the addresses that did not open stayed behind")
+	}
+	if r.sorter.detour.on.Load() {
+		t.Error("something still goes through the VPN")
+	}
+}
+
+// a port that went through the VPN comes back by itself the same way
+func TestProbeHealsPort(t *testing.T) {
+	quickHealing(t)
+	r := newRig(t)
+	r.refused.Store(true)
+	for i := 0; i < portFailures; i++ {
+		r.tryTCP(siteN(i), 443)
+	}
+	if r.sorter.Takes(synTo(siteN(9), 443)) {
+		t.Fatal("port 443 did not go through the VPN")
+	}
+	r.refused.Store(false)
+	if !r.waitFor(func() bool { return r.sorter.Takes(synTo(siteN(9), 443)) }) {
+		t.Fatal("port 443 did not come back by itself after it opened")
+	}
+}
+
+// while the computer still keeps everything from opening, the tries in the background go on
+// and change nothing
+func TestProbeKeepsDivertedWhileBlocked(t *testing.T) {
+	quickHealing(t)
+	r := newRig(t)
+	r.refused.Store(true)
+	for i, port := range []uint16{443, 80, 8443, 5222, 993} {
+		r.tryTCP(siteN(i), port)
+	}
+	dials := r.dials.Load()
+	time.Sleep(400 * time.Millisecond)
+	if r.dials.Load() <= dials {
+		t.Error("nothing was tried in the background")
+	}
+	if r.sorter.Takes(synTo(siteN(9), 12345)) {
+		t.Error("everything came back though nothing opens")
+	}
+}
+
+// an address that goes through the VPN alone is tried less and less often
+func TestProbeBacksOff(t *testing.T) {
+	quickHealing(t)
+	r := newRig(t)
+	r.refused.Store(true)
+	r.tryTCP(siteDirect, 443)
+	dials := r.dials.Load()
+	time.Sleep(700 * time.Millisecond)
+	tried := r.dials.Load() - dials
+	// every healEvery it would be 35; with the gap doubling up to 80 ms about 9
+	if tried < 2 || tried > 15 {
+		t.Errorf("%d tries in the background in 700 ms, want a few and fewer and fewer", tried)
+	}
+}
