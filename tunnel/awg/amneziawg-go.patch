@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+package device
+
+import (
+	"net/netip"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/sorter"
+)
+
+// setDirectNetworks makes prefixes the networks whose TCP and UDP connections the device opens
+// by its own network instead of sending them to a peer (package sorter); none stops that. The
+// "direct_network" lines of one UAPI set operation give the whole list.
+func (device *Device) setDirectNetworks(prefixes []netip.Prefix) {
+	networks := sorter.NewSet(prefixes)
+	if networks.Len() == 0 {
+		if s := device.direct.Swap(nil); s != nil {
+			s.Close()
+		}
+		device.log.Verbosef("UAPI: No networks are opened directly")
+		return
+	}
+	s := device.direct.Load()
+	if s == nil {
+		var err error
+		s, err = sorter.New(device.tun.device.Write, MessageTransportOffsetContent, int(device.tun.mtu.Load()), device.log.Verbosef)
+		if err != nil {
+			device.log.Errorf("Unable to open networks directly: %v", err)
+			return
+		}
+		device.direct.Store(s)
+	}
+	s.SetNetworks(networks)
+	device.log.Verbosef("UAPI: %d networks are opened directly (%d ranges)", len(prefixes), networks.Len())
+}
diff --git a/device/sorter_test.go b/device/sorter_test.go
