diff --git a/sorter/control_windows.go b/sorter/control_windows.go
new file mode 100644
index 0000000..f6a3b48
--- /dev/null
+++ b/sorter/control_windows.go
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+package sorter
+
+import (
+	"encoding/binary"
+	"errors"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+var interface4 atomic.Uint32
+
+// SetInterface4 makes the direct sockets leave by the network interface with this index: the
+// physical network's, as the best default route that is not the tunnel's finds it (the tunnel
+// service follows it). 0: there is no such network now, and a direct connection is refused
+// rather than sent into the tunnel again.
+func SetInterface4(index uint32) {
+	interface4.Store(index)
+}
+
+func init() {
+	SetDialControl(bindToInterface4)
+}
+
+// bindToInterface4 binds a direct socket to the physical network (IP_UNICAST_IF), the way the
+// WireGuard service binds its own socket: the routes that take everything into the tunnel are
+// not on that interface, so the socket's packets go around them.
+func bindToInterface4(network, address string, c syscall.RawConn) error {
+	index := interface4.Load()
+	if index == 0 {
+		return errors.New("no physical network to leave by")
+	}
+	// for IPv4 the option takes the index in network byte order
+	var b [4]byte
+	binary.BigEndian.PutUint32(b[:], index)
+	value := *(*uint32)(unsafe.Pointer(&b[0]))
+	const ipUnicastIf = 31
+	var serr error
+	err := c.Control(func(fd uintptr) {
+		serr = windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IP, ipUnicastIf, int(value))
+	})
+	if err != nil {
+		return err
+	}
+	return serr
+}
diff --git a/sorter/detour.go b/sorter/detour.go
new file mode 100644
index 0000000..202ab29
--- /dev/null
+++ b/sorter/detour.go
@@ -0,0 +1,390 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+package sorter
+
+import (
+	"encoding/binary"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+const (
+	// so many addresses on one TCP port that did not open directly, with none on it that did:
+	// the computer itself keeps that port from opening directly (an antivirus that takes the
+	// connections to 80 and 443 over, zapret), and the whole port goes through the VPN
+	portFailures = 3
+	// so many addresses that did not open directly, with nothing at all that did: everything
+	// goes through the VPN
+	allFailures = 5
+
+	// addresses tried at once in the background while a TCP port, or everything, goes through the VPN
+	probeBatch = 3
+	// once one of them has opened, what kept them from opening is gone: the rest are tried at once
+	probeAfterHeal = 32
+
+	protoTCP = uint8(header.TCPProtocolNumber)
+	protoUDP = uint8(header.UDPProtocolNumber)
+)
+
+var (
+	// how long a TCP port, or everything, goes through the VPN before one new connection tries
+	// directly again: what kept it from opening directly may be gone (zapret turned off), or the
+	// addresses that did not open were only sites that were down. A UDP address waits as long.
+	retryDirect = 10 * time.Minute
+
+	// how often the sorter tries the TCP addresses that did not open directly again, in the
+	// background, with a plain connection closed at once (detour.probes): the one who turned
+	// zapret off, or answered the antivirus, should not have to wait for a connection of his own
+	healEvery = 10 * time.Second
+	// an address that goes through the VPN alone (nothing wider does) is tried less and less
+	// often: a site that is down is not worth a try every healEvery
+	maxProbeGap = 5 * time.Minute
+)
+
+// detour is what goes through the VPN instead because it did not open directly: an address
+// whose connection did not open (no answer, refused, or the computer kept it from opening), a
+// TCP port on which several addresses did not open and none did, or everything once nothing
+// opens directly at all. New connections there go to the peer; the ones the sorter carries
+// stay with it. What went through the VPN is tried directly again: the addresses in the
+// background (probes), a port or everything also by one new connection now and then
+// (retryDirect); UDP addresses simply after retryDirect.
+type detour struct {
+	on atomic.Bool // anything goes through the VPN instead: only then Takes looks further
+
+	mu        sync.Mutex
+	all       bool
+	allSince  time.Time              // since when everything goes through the VPN, or was last tried
+	addrs     map[uint32]*missedAddr // addresses whose TCP connection did not open directly
+	udpAddrs  map[uint32]time.Time   // addresses whose UDP flow got no answer: since when
+	ports     map[uint16]time.Time   // TCP ports that do not open directly here: since when, or the last try
+	tries     map[uint16]*portTries  // per TCP port: addresses opened and not opened on it
+	opens     int                    // flows that opened directly, any port or protocol
+	misses    int                    // addresses that did not open directly
+	flows     map[flowKey]struct{}   // the flows the sorter is opening or carries
+	flowsAddr map[uint32]int         // how many of them go to each address
+	trial     flowKey                // the connection that tries directly again, since trialAt
+	trialAt   time.Time
+}
+
+// missedAddr is an address whose TCP connection did not open directly
+type missedAddr struct {
+	port   uint16        // the port it did not open on: where the tries in the background go
+	since  time.Time     // when it did not open
+	probed time.Time     // when it was last tried in the background (zero: not yet)
+	gap    time.Duration // how long before the next try while only this address goes through the VPN
+}
+
+type portTries struct{ opened, missed int }
+
+// flowKey is a flow as the packets of the app's side name it: protocol, the app's address and
+// port, the site's address and port.
+type flowKey struct {
+	proto             uint8
+	app, site         uint32
+	appPort, sitePort uint16
+}
+
+// flowOf is the flow of a connection the stack hands over (its local side is the site's).
+func flowOf(proto uint8, id stack.TransportEndpointID) flowKey {
+	return flowKey{
+		proto:    proto,
+		app:      addr4(id.RemoteAddress.As4()),
+		appPort:  id.RemotePort,
+		site:     addr4(id.LocalAddress.As4()),
+		sitePort: id.LocalPort,
+	}
+}
+
+// takes reports whether a packet to one of the networks still goes to the sorter now that
+// something goes through the VPN instead: one of a flow the sorter carries does, a new one
+// does unless its address, its TCP port or everything goes through the VPN - or it is the one
+// that tries directly again.
+func (d *detour) takes(packet []byte) bool {
+	proto := packet[9]
+	site := binary.BigEndian.Uint32(packet[16:20])
+	ihl := int(packet[0]&0x0f) * 4
+	later := binary.BigEndian.Uint16(packet[6:8])&0x1fff != 0
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if later || ihl < header.IPv4MinimumSize || len(packet) < ihl+4 {
+		// no ports here (a fragment after the first): it follows the address
+		return d.flowsAddr[site] > 0 || !(d.all || d.missedLocked(site, proto))
+	}
+	flow := flowKey{
+		proto:    proto,
+		app:      binary.BigEndian.Uint32(packet[12:16]),
+		appPort:  binary.BigEndian.Uint16(packet[ihl:]),
+		site:     site,
+		sitePort: binary.BigEndian.Uint16(packet[ihl+2:]),
+	}
+	if _, ok := d.flows[flow]; ok {
+		return true
+	}
+	return !d.divertedLocked(flow) || d.tryAgainLocked(flow, isSYN(packet))
+}
+
+// missedLocked: an earlier flow of this protocol to the address did not open directly. A TCP
+// address stays so until it is tried in the background and opens; a UDP flow cannot be tried
+// without a site that answers, so its address goes through the VPN for retryDirect only.
+func (d *detour) missedLocked(site uint32, proto uint8) bool {
+	if proto == protoTCP {
+		_, ok := d.addrs[site]
+		return ok
+	}
+	since, ok := d.udpAddrs[site]
+	if ok && time.Since(since) >= retryDirect {
+		delete(d.udpAddrs, site)
+		d.refreshLocked()
+		return false
+	}
+	return ok
+}
+
+// refreshLocked sets whether anything goes through the VPN instead
+func (d *detour) refreshLocked() {
+	d.on.Store(d.all || len(d.addrs) > 0 || len(d.udpAddrs) > 0 || len(d.ports) > 0)
+}
+
+func (d *detour) divertedLocked(flow flowKey) bool {
+	if d.all || d.missedLocked(flow.site, flow.proto) {
+		return true
+	}
+	_, port := d.ports[flow.sitePort]
+	return port && flow.proto == protoTCP
+}
+
+// tryAgainLocked lets a new TCP connection (its SYN) that goes through the VPN for its port or
+// for everything, not for its address, try directly once retryDirect has passed: one at a time.
+func (d *detour) tryAgainLocked(flow flowKey, syn bool) bool {
+	if flow.proto != protoTCP || !syn || d.missedLocked(flow.site, protoTCP) {
+		return false
+	}
+	if !d.trialAt.IsZero() && time.Since(d.trialAt) < 2*openTimeout {
+		return false // one is trying
+	}
+	since := d.allSince
+	if !d.all {
+		since = d.ports[flow.sitePort]
+	}
+	if time.Since(since) < retryDirect {
+		return false
+	}
+	d.trial, d.trialAt = flow, time.Now()
+	return true
+}
+
+func (d *detour) trying(flow flowKey) bool {
+	return !d.trialAt.IsZero() && flow == d.trial
+}
+
+// carry makes a flow the sorter's while it opens and lives (release ends that). False: it
+// goes through the VPN instead, or the sorter has it already.
+func (d *detour) carry(flow flowKey) bool {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if _, ok := d.flows[flow]; ok {
+		return false
+	}
+	if d.divertedLocked(flow) && !d.trying(flow) {
+		return false
+	}
+	if d.flows == nil {
+		d.flows = make(map[flowKey]struct{})
+		d.flowsAddr = make(map[uint32]int)
+	}
+	d.flows[flow] = struct{}{}
+	d.flowsAddr[flow.site]++
+	return true
+}
+
+func (d *detour) release(flow flowKey) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if _, ok := d.flows[flow]; !ok {
+		return
+	}
+	delete(d.flows, flow)
+	if d.flowsAddr[flow.site]--; d.flowsAddr[flow.site] <= 0 {
+		delete(d.flowsAddr, flow.site)
+	}
+}
+
+// opened counts a flow that opened directly: a TCP connection, a UDP flow the site answered.
+// The one that tried directly again brings its port, or everything, back: then it tells which
+// (all: everything), and the counts start over, so the computer that keeps them from opening
+// again is found as at the start.
+func (d *detour) opened(flow flowKey) (again, all bool) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.opens++
+	if flow.proto == protoTCP {
+		d.port(flow.sitePort).opened++
+	}
+	if !d.trying(flow) {
+		return
+	}
+	d.trialAt = time.Time{}
+	_, port := d.ports[flow.sitePort]
+	if !d.all && !port {
+		return
+	}
+	again, all = true, d.all
+	d.all = false
+	delete(d.ports, flow.sitePort)
+	d.tries[flow.sitePort] = &portTries{}
+	d.opens, d.misses = 0, 0
+	d.refreshLocked()
+	return
+}
+
+// failed sends the address of a flow that did not open directly through the VPN from now on,
+// and its TCP port, or everything, once nothing opens directly there. It tells whether this was
+// the first address, and whether the port or everything went through the VPN by it.
+func (d *detour) failed(flow flowKey) (first, port, all bool) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.trying(flow) {
+		// the try directly again did not open either: the next one in retryDirect
+		d.trialAt = time.Time{}
+		if d.all {
+			d.allSince = time.Now()
+		} else if _, ok := d.ports[flow.sitePort]; ok {
+			d.ports[flow.sitePort] = time.Now()
+		}
+	}
+	if d.missedLocked(flow.site, flow.proto) {
+		return // a connection beside it said so already
+	}
+	now := time.Now()
+	if flow.proto == protoTCP {
+		if d.addrs == nil {
+			d.addrs = make(map[uint32]*missedAddr)
+		}
+		d.addrs[flow.site] = &missedAddr{port: flow.sitePort, since: now, gap: healEvery}
+	} else {
+		if d.udpAddrs == nil {
+			d.udpAddrs = make(map[uint32]time.Time)
+		}
+		d.udpAddrs[flow.site] = now
+	}
+	if d.ports == nil {
+		d.ports = make(map[uint16]time.Time)
+	}
+	d.misses++
+	first = d.misses == 1 && len(d.addrs)+len(d.udpAddrs) == 1
+	if flow.proto == protoTCP {
+		p := d.port(flow.sitePort)
+		p.missed++
+		if _, gone := d.ports[flow.sitePort]; !gone && p.opened == 0 && p.missed >= portFailures {
+			d.ports[flow.sitePort] = now
+			port = true
+		}
+	}
+	if !d.all && d.opens == 0 && d.misses >= allFailures {
+		d.all, d.allSince = true, now
+		all = true
+	}
+	d.refreshLocked()
+	return
+}
+
+// probes picks the TCP addresses to try directly in the background now, at most limit of them:
+// the ones never tried first, then the ones tried longest ago, the newest failures first. While
+// a port or everything goes through the VPN every address is due (the cause may be gone, and
+// any one that opens brings that back); an address that goes through the VPN alone is due
+// when its gap has passed, unless force asks for all.
+func (d *detour) probes(limit int, force bool) []flowKey {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if len(d.addrs) == 0 {
+		return nil
+	}
+	wide := force || d.all || len(d.ports) > 0
+	now := time.Now()
+	due := make([]uint32, 0, len(d.addrs))
+	for addr, m := range d.addrs {
+		if wide || now.Sub(m.probed) >= m.gap {
+			due = append(due, addr)
+		}
+	}
+	sort.Slice(due, func(i, j int) bool {
+		a, b := d.addrs[due[i]], d.addrs[due[j]]
+		if !a.probed.Equal(b.probed) {
+			return a.probed.Before(b.probed)
+		}
+		return a.since.After(b.since)
+	})
+	if len(due) > limit {
+		due = due[:limit]
+	}
+	picked := make([]flowKey, 0, len(due))
+	for _, addr := range due {
+		m := d.addrs[addr]
+		m.probed = now
+		picked = append(picked, flowKey{proto: protoTCP, site: addr, sitePort: m.port})
+	}
+	return picked
+}
+
+// probeFailed: a try in the background did not open. An address that goes through the VPN alone
+// is tried less often from now on.
+func (d *detour) probeFailed(flow flowKey) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if m := d.addrs[flow.site]; m != nil {
+		if m.gap *= 2; m.gap > maxProbeGap {
+			m.gap = maxProbeGap
+		}
+	}
+}
+
+// healed: a try in the background opened directly. The address comes back, and so do its TCP
+// port, or everything, if they went through the VPN because nothing opened; the counts start
+// over as in opened.
+func (d *detour) healed(flow flowKey) (again, all bool) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	delete(d.addrs, flow.site)
+	d.opens++
+	d.port(flow.sitePort).opened++
+	_, port := d.ports[flow.sitePort]
+	if d.all || port {
+		again, all = true, d.all
+		d.all = false
+		delete(d.ports, flow.sitePort)
+		d.tries[flow.sitePort] = &portTries{}
+		d.opens, d.misses = 0, 0
+	}
+	d.refreshLocked()
+	return
+}
+
+func (d *detour) port(n uint16) *portTries {
+	if d.tries == nil {
+		d.tries = make(map[uint16]*portTries)
+	}
+	p := d.tries[n]
+	if p == nil {
+		p = &portTries{}
+		d.tries[n] = p
+	}
+	return p
+}
+
+// isSYN reports whether an IPv4 packet is a TCP SYN that opens a connection (no ACK).
+func isSYN(packet []byte) bool {
+	ihl := int(packet[0]&0x0f) * 4
+	if packet[9] != protoTCP || ihl < header.IPv4MinimumSize || len(packet) < ihl+14 ||
+		binary.BigEndian.Uint16(packet[6:8])&0x1fff != 0 {
+		return false
+	}
+	return header.TCPFlags(packet[ihl+13])&(header.TCPFlagSyn|header.TCPFlagAck) == header.TCPFlagSyn
+}
diff --git a/sorter/set.go b/sorter/set.go
new file mode 100644
index 0000000..306d627
--- /dev/null
+++ b/sorter/set.go
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+package sorter
+
+import (
+	"net/netip"
+	"sort"
+)
+
+// Set is a set of IPv4 networks kept as sorted address ranges that neither overlap nor touch:
+// a lookup is one binary search, some 13 steps for the 8,700 networks of a country.
+type Set struct {
+	first []uint32 // the first address of each range, ascending
+	last  []uint32 // the last address of the same range
+}
+
+// NewSet makes a set of the IPv4 networks among prefixes (anything else is left out).
+func NewSet(prefixes []netip.Prefix) *Set {
+	type span struct{ first, last uint32 }
+	spans := make([]span, 0, len(prefixes))
+	for _, p := range prefixes {
+		if !p.Addr().Is4() || !p.IsValid() {
+			continue
+		}
+		p = p.Masked()
+		first := addr4(p.Addr().As4())
+		size := uint64(1) << (32 - p.Bits())
+		spans = append(spans, span{first, uint32(uint64(first) + size - 1)})
+	}
+	sort.Slice(spans, func(i, j int) bool { return spans[i].first < spans[j].first })
+
+	s := &Set{}
+	for _, sp := range spans {
+		n := len(s.first)
+		// one inside, overlapping or right after the previous range: it grows that range
+		if n > 0 && uint64(sp.first) <= uint64(s.last[n-1])+1 {
+			if sp.last > s.last[n-1] {
+				s.last[n-1] = sp.last
+			}
+			continue
+		}
+		s.first = append(s.first, sp.first)
+		s.last = append(s.last, sp.last)
+	}
+	return s
+}
+
+// Len is the number of ranges the networks came to.
+func (s *Set) Len() int {
+	return len(s.first)
+}
+
+// Contains reports whether the IPv4 address (4 bytes, network order) is in one of the networks.
+func (s *Set) Contains(ip []byte) bool {
+	a := uint32(ip[0])<<24 | uint32(ip[1])<<16 | uint32(ip[2])<<8 | uint32(ip[3])
+	// the first range that starts after the address: the one before it may hold the address
+	i := sort.Search(len(s.first), func(i int) bool { return s.first[i] > a })
+	return i > 0 && a <= s.last[i-1]
+}
+
+func addr4(b [4]byte) uint32 {
+	return uint32(b[0])<<24 | uint32(b[1])<<16 | uint32(b[2])<<8 | uint32(b[3])
+}
diff --git a/sorter/sorter.go b/sorter/sorter.go
new file mode 100644
index 0000000..ece7a01
--- /dev/null
+++ b/sorter/sorter.go
@@ -0,0 +1,647 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+// Package sorter lets a tunnel device open by itself, over the device's own network, the
+// connections to a set of IPv4 networks that would otherwise go to a peer: LodestarVPN's
+// «Russian sites directly» for AmneziaWG, the way a rule of Xray does it for VLESS. Such a
+// packet never reaches a peer. A user-space TCP/IP stack (gVisor) plays the far side of the
+// app's connection, and the sorter carries the data over an ordinary socket that the platform
+// keeps out of the VPN (SetDialControl). Everything else goes to the peers as before, and no
+// route of the system is needed, however many networks there are. What the computer does not
+// let open directly (an antivirus that takes connections over, zapret, a firewall) goes to the
+// peer instead, through the VPN (detour.go).
+package sorter
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+	"gvisor.dev/gvisor/pkg/waiter"
+)
+
+var (
+	// how long the direct socket of a TCP connection may take to open; one that does not open
+	// by then goes through the VPN. A site answers in well under a second, and the app sends
+	// its SYN again 1 and 3 s after the first (Windows, Android): the one at 3 s goes there.
+	openTimeout = 2500 * time.Millisecond
+	// how long a UDP flow (a QUIC handshake, a DNS query) may wait for the site's first answer;
+	// one that has none by then ends, and the app's next datagrams go through the VPN
+	answerTimeout = 2500 * time.Millisecond
+)
+
+const (
+	nicID = 1
+	// TCP connections that may wait for their direct socket at once (more SYNs are dropped
+	// and come again)
+	maxPendingTCP = 512
+	// once one side of a TCP connection has finished sending, how long the other may go on
+	halfClosedTimeout = 2 * time.Minute
+	// a UDP flow that carried nothing either way for so long is forgotten (a DNS query sooner)
+	udpIdle    = 2 * time.Minute
+	dnsUDPIdle = 20 * time.Second
+	// packets the stack may queue on their way into the tunnel device
+	queueLen = 1024
+	// packets handed to the tunnel device in one write
+	writeBatch = 32
+	// the copy buffers of a connection
+	copyBufferSize = 32 << 10
+	udpBufferSize  = 64 << 10
+)
+
+var dialControl atomic.Pointer[func(network, address string, c syscall.RawConn) error]
+
+// SetDialControl sets what every direct socket goes through before it connects: the platform's
+// way of keeping it out of the VPN (Android: VpnService.protect; Windows: a bind to the physical
+// network, SetInterface4). It must fail when it cannot do that, or the connection would come
+// back into the tunnel. Without one no direct socket is opened at all.
+func SetDialControl(fn func(network, address string, c syscall.RawConn) error) {
+	if fn == nil {
+		dialControl.Store(nil)
+		return
+	}
+	dialControl.Store(&fn)
+}
+
+// dial opens a direct socket (tests take it over)
+var dial = func(ctx context.Context, network, address string) (net.Conn, error) {
+	fn := dialControl.Load()
+	if fn == nil {
+		return nil, errNoDialControl
+	}
+	d := &net.Dialer{Control: *fn}
+	return d.DialContext(ctx, network, address)
+}
+
+var errNoDialControl = errors.New("no way to keep a direct socket out of the VPN")
+
+// Sorter plays the far side of the apps' connections to its networks and carries their data
+// over direct sockets.
+type Sorter struct {
+	networks atomic.Pointer[Set]
+
+	stack *stack.Stack
+	ep    *channel.Endpoint
+
+	write  func(bufs [][]byte, offset int) (int, error)
+	offset int
+	logf   func(format string, args ...any)
+
+	packets sync.Pool // buffers of packets on their way into the tunnel device
+	copies  sync.Pool // copy buffers of TCP connections
+
+	ctx    context.Context
+	cancel context.CancelFunc
+	wg     sync.WaitGroup
+
+	mu     sync.Mutex
+	open   map[io.Closer]struct{} // every live connection: closed with the sorter
+	closed bool
+
+	// the flows the sorter carries, and what goes through the VPN instead (detour.go)
+	detour detour
+
+	tcpOpened, udpOpened, failed atomic.Uint64
+	viaVPN                       atomic.Uint64 // TCP connections that went through the VPN instead
+	writeErrors                  atomic.Uint64
+
+	// the data the direct connections carried, each byte once: what the sites sent the apps (rx) and
+	// the apps the sites (tx). Not the packets: the stack sends again what the tunnel device dropped
+	// (a full ring on Windows drops without an error), and counting those showed 2-3 times the speed
+	rxBytes, txBytes atomic.Uint64
+}
+
+// New starts a sorter that hands the packets of the connections it plays to write - the tunnel
+// device's own Write, given bufs with offset bytes of room before each packet - and logs by
+// logf. mtu is the tunnel device's.
+func New(write func(bufs [][]byte, offset int) (int, error), offset, mtu int, logf func(format string, args ...any)) (*Sorter, error) {
+	s := &Sorter{
+		write:  write,
+		offset: offset,
+		logf:   logf,
+		open:   make(map[io.Closer]struct{}),
+	}
+	s.ctx, s.cancel = context.WithCancel(context.Background())
+	packetSize := offset + mtu
+	s.packets.New = func() any {
+		b := make([]byte, packetSize)
+		return &b
+	}
+	s.copies.New = func() any {
+		b := make([]byte, copyBufferSize)
+		return &b
+	}
+
+	s.stack = stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol, udp.NewProtocol},
+	})
+	fail := func(err error) (*Sorter, error) {
+		s.cancel()
+		s.stack.Close()
+		return nil, err
+	}
+	sack := tcpip.TCPSACKEnabled(true)
+	moderate := tcpip.TCPModerateReceiveBufferOption(true)
+	for _, opt := range []tcpip.SettableTransportProtocolOption{&sack, &moderate} {
+		if err := s.stack.SetTransportProtocolOption(tcp.ProtocolNumber, opt); err != nil {
+			return fail(fmt.Errorf("TCP option: %v", err))
+		}
+	}
+	s.ep = channel.New(queueLen, uint32(mtu), "")
+	if err := s.stack.CreateNIC(nicID, s.ep); err != nil {
+		return fail(fmt.Errorf("CreateNIC: %v", err))
+	}
+	// the stack answers for whatever address an app connects to, and sends from it
+	if err := s.stack.SetPromiscuousMode(nicID, true); err != nil {
+		return fail(fmt.Errorf("SetPromiscuousMode: %v", err))
+	}
+	if err := s.stack.SetSpoofing(nicID, true); err != nil {
+		return fail(fmt.Errorf("SetSpoofing: %v", err))
+	}
+	s.stack.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: nicID}})
+
+	tcpForwarder := tcp.NewForwarder(s.stack, 0, maxPendingTCP, s.handleTCP)
+	s.stack.SetTransportProtocolHandler(tcp.ProtocolNumber, tcpForwarder.HandlePacket)
+	udpForwarder := udp.NewForwarder(s.stack, s.handleUDP)
+	s.stack.SetTransportProtocolHandler(udp.ProtocolNumber, udpForwarder.HandlePacket)
+
+	s.wg.Add(3)
+	go s.toTunnel()
+	go s.report()
+	go s.heal()
+	return s, nil
+}
+
+// Bytes tells the data the direct connections carried so far: rx what the sites sent the apps, tx
+// what the apps sent them. With a peer's rx_bytes and tx_bytes (its packets: a few per cent more
+// for the headers) it is what the device's apps get and send: the speed the app shows (the peer's
+// alone left out every site the device opened directly).
+func (s *Sorter) Bytes() (rx, tx uint64) {
+	return s.rxBytes.Load(), s.txBytes.Load()
+}
+
+// SetNetworks makes networks the ones whose connections the sorter opens itself.
+func (s *Sorter) SetNetworks(networks *Set) {
+	s.networks.Store(networks)
+}
+
+// Takes reports whether an IPv4 packet read from the tunnel device is the sorter's: TCP or UDP
+// to one of its networks, unless the computer kept such a connection from opening directly
+// (then new ones go to the peer, and the ones the sorter carries stay with it). Any other
+// protocol (ICMP: a ping) goes to the peer as before.
+func (s *Sorter) Takes(packet []byte) bool {
+	if len(packet) < header.IPv4MinimumSize {
+		return false
+	}
+	if p := packet[9]; p != uint8(header.TCPProtocolNumber) && p != uint8(header.UDPProtocolNumber) {
+		return false
+	}
+	networks := s.networks.Load()
+	if networks == nil || !networks.Contains(packet[16:20]) {
+		return false
+	}
+	if s.detour.on.Load() && !s.detour.takes(packet) {
+		if isSYN(packet) {
+			s.viaVPN.Add(1)
+		}
+		return false
+	}
+	return true
+}
+
+// Deliver hands the sorter a packet it takes. The packet is copied: its buffer may be reused.
+func (s *Sorter) Deliver(packet []byte) {
+	if s.ctx.Err() != nil {
+		return
+	}
+	pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(packet)})
+	s.ep.InjectInbound(header.IPv4ProtocolNumber, pkt)
+	pkt.DecRef()
+}
+
+// Close ends every connection the sorter carries and stops it.
+func (s *Sorter) Close() {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return
+	}
+	s.closed = true
+	open := s.open
+	s.open = nil
+	s.mu.Unlock()
+
+	s.cancel()
+	for c := range open {
+		c.Close()
+	}
+	s.stack.Close()
+	s.ep.Close()
+	s.wg.Wait()
+	s.stack.Wait()
+}
+
+// toTunnel carries what the stack sends - the far sides' answers - into the tunnel device, as
+// if they had come from a peer.
+func (s *Sorter) toTunnel() {
+	defer s.wg.Done()
+	bufs := make([][]byte, 0, writeBatch)
+	held := make([]*[]byte, 0, writeBatch)
+	for {
+		pkt := s.ep.ReadContext(s.ctx)
+		if pkt.IsNil() {
+			return
+		}
+		for {
+			b := s.packets.Get().(*[]byte)
+			if need := s.offset + pkt.Size(); need > len(*b) {
+				big := make([]byte, need)
+				b = &big
+			}
+			n := s.offset
+			for _, v := range pkt.AsSlices() {
+				n += copy((*b)[n:], v)
+			}
+			pkt.DecRef()
+			bufs = append(bufs, (*b)[:n])
+			held = append(held, b)
+			if len(bufs) == writeBatch {
+				break
+			}
+			if pkt = s.ep.Read(); pkt.IsNil() {
+				break
+			}
+		}
+		if _, err := s.write(bufs, s.offset); err != nil && s.ctx.Err() == nil {
+			if s.writeErrors.Add(1) == 1 {
+				s.logf("Sorter: writing into the tunnel device: %v", err)
+			}
+		}
+		for _, b := range held {
+			s.packets.Put(b)
+		}
+		bufs, held = bufs[:0], held[:0]
+	}
+}
+
+// report logs, once a minute while anything changed, how many connections went directly.
+func (s *Sorter) report() {
+	defer s.wg.Done()
+	ticker := time.NewTicker(time.Minute)
+	defer ticker.Stop()
+	var last [5]uint64
+	for {
+		select {
+		case <-s.ctx.Done():
+			return
+		case <-ticker.C:
+		}
+		now := [5]uint64{s.tcpOpened.Load(), s.udpOpened.Load(), s.failed.Load(), s.viaVPN.Load(), s.writeErrors.Load()}
+		if now != last {
+			s.logf("Sorter: opened directly %d TCP connections and %d UDP flows so far, %d did not open, %d TCP connections went through the VPN instead, %d writes into the tunnel failed",
+				now[0], now[1], now[2], now[3], now[4])
+			last = now
+		}
+	}
+}
+
+// heal tries the TCP addresses that did not open directly again now and then (detour.probes):
+// a plain connection, closed at once. What kept them from opening may be gone - zapret turned
+// off, an antivirus that waited for an answer given - and nobody should have to wait at a site
+// for the sorter to find out: the next connection of the app simply goes directly. When one
+// opens, the rest are tried at once.
+func (s *Sorter) heal() {
+	defer s.wg.Done()
+	ticker := time.NewTicker(healEvery)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-s.ctx.Done():
+			return
+		case <-ticker.C:
+		}
+		if !s.detour.on.Load() {
+			continue
+		}
+		if s.probe(s.detour.probes(probeBatch, false)) > 0 && s.ctx.Err() == nil {
+			s.probe(s.detour.probes(probeAfterHeal, true))
+		}
+	}
+}
+
+// probe tries these addresses directly, together, and tells how many opened. Nothing about them
+// is logged but how many came back, and what that brought back with them.
+func (s *Sorter) probe(targets []flowKey) int {
+	var wg sync.WaitGroup
+	var opened atomic.Int64
+	var port, all atomic.Bool
+	var portNumber atomic.Uint32
+	for _, target := range targets {
+		wg.Add(1)
+		go func(t flowKey) {
+			defer wg.Done()
+			ctx, cancel := context.WithTimeout(s.ctx, openTimeout)
+			c, err := dial(ctx, "tcp4", siteSide(t))
+			cancel()
+			if err != nil {
+				s.detour.probeFailed(t)
+				return
+			}
+			c.Close()
+			opened.Add(1)
+			again, wholly := s.detour.healed(t)
+			if again {
+				port.Store(true)
+				portNumber.Store(uint32(t.sitePort))
+				if wholly {
+					all.Store(true)
+				}
+			}
+		}(target)
+	}
+	wg.Wait()
+	switch {
+	case all.Load():
+		s.logf("Sorter: connections open directly again on this computer: they go directly from now on")
+	case port.Load():
+		s.logf("Sorter: TCP port %d opens directly again on this computer: it goes directly from now on", portNumber.Load())
+	case opened.Load() > 0:
+		s.logf("Sorter: %d addresses that did not open directly open again: they go directly from now on", opened.Load())
+	}
+	return int(opened.Load())
+}
+
+func (s *Sorter) track(conns ...io.Closer) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		for _, c := range conns {
+			c.Close()
+		}
+		return false
+	}
+	for _, c := range conns {
+		s.open[c] = struct{}{}
+	}
+	return true
+}
+
+func (s *Sorter) untrack(conns ...io.Closer) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, c := range conns {
+		delete(s.open, c)
+	}
+}
+
+func farSide(id stack.TransportEndpointID) string {
+	return netip.AddrPortFrom(netip.AddrFrom4(id.LocalAddress.As4()), id.LocalPort).String()
+}
+
+// siteSide is the site a flow goes to, as an address to dial
+func siteSide(flow flowKey) string {
+	var a [4]byte
+	binary.BigEndian.PutUint32(a[:], flow.site)
+	return netip.AddrPortFrom(netip.AddrFrom4(a), flow.sitePort).String()
+}
+
+// handleTCP opens an app's TCP connection to one of the networks: the direct socket to the site
+// first, then the app's side. One that does not open directly in openTimeout - a site that does
+// not answer, or refuses, or the computer keeps it from opening - gets no answer at all: the
+// app sends its SYN again, and that one goes through the VPN (detour.go), where a site that
+// refuses refuses it again. The stack calls it in a goroutine of its own.
+func (s *Sorter) handleTCP(r *tcp.ForwarderRequest) {
+	id := r.ID()
+	flow := flowOf(protoTCP, id)
+	if !s.detour.carry(flow) {
+		// its way went through the VPN after this SYN came: the next one goes there
+		r.Complete(false)
+		return
+	}
+	ctx, cancel := context.WithTimeout(s.ctx, openTimeout)
+	out, err := dial(ctx, "tcp4", farSide(id))
+	cancel()
+	if err != nil {
+		if s.ctx.Err() == nil {
+			s.notOpened(flow)
+			s.failed.Add(1)
+		}
+		s.detour.release(flow)
+		r.Complete(false)
+		return
+	}
+	// opened directly: counted before the app learns it
+	if again, all := s.detour.opened(flow); again && all {
+		s.logf("Sorter: connections open directly again on this computer: they go directly from now on")
+	} else if again {
+		s.logf("Sorter: TCP port %d opens directly again on this computer: it goes directly from now on", flow.sitePort)
+	}
+	var wq waiter.Queue
+	ep, terr := r.CreateEndpoint(&wq)
+	if terr != nil {
+		s.detour.release(flow)
+		r.Complete(true)
+		out.Close()
+		return
+	}
+	r.Complete(false)
+	in := gonet.NewTCPConn(&wq, ep)
+	if !s.track(in, out) {
+		s.detour.release(flow)
+		return
+	}
+	s.tcpOpened.Add(1)
+	s.relayTCP(in, out.(*net.TCPConn))
+	s.untrack(in, out)
+	s.detour.release(flow)
+}
+
+// notOpened sends what a flow went to through the VPN from now on (detour.failed) and logs
+// the first such flow and what goes through the VPN as a whole: no addresses in the log.
+func (s *Sorter) notOpened(flow flowKey) {
+	first, port, all := s.detour.failed(flow)
+	if first {
+		s.logf("Sorter: a connection did not open directly: it and the next ones to its address go through the VPN")
+	}
+	if port {
+		s.logf("Sorter: TCP port %d does not open directly on this computer (%d addresses tried, none opened): it goes through the VPN, tried directly again every %v",
+			flow.sitePort, portFailures, healEvery)
+	}
+	if all {
+		s.logf("Sorter: nothing opens directly on this computer (%d addresses tried, none opened): all of it goes through the VPN, tried directly again every %v",
+			allFailures, healEvery)
+	}
+}
+
+// relayTCP carries a connection's data both ways until both have finished, or one has and the
+// other stays quiet for halfClosedTimeout, then closes it.
+func (s *Sorter) relayTCP(in *gonet.TCPConn, out *net.TCPConn) {
+	var halfClosed atomic.Bool
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		s.pipe(out, in, &halfClosed, &s.txBytes) // the app's data to the site
+		out.CloseWrite()
+		halfClosed.Store(true)
+		out.SetReadDeadline(time.Now().Add(halfClosedTimeout))
+	}()
+	s.pipe(in, out, &halfClosed, &s.rxBytes) // the site's data to the app
+	in.CloseWrite()
+	halfClosed.Store(true)
+	in.SetReadDeadline(time.Now().Add(halfClosedTimeout))
+	<-done
+	in.Close()
+	out.Close()
+}
+
+// pipe copies src to dst until src ends or either fails, adding what it wrote to counted; once the
+// other way has finished, each read moves the deadline of the next one on.
+func (s *Sorter) pipe(dst io.Writer, src net.Conn, halfClosed *atomic.Bool, counted *atomic.Uint64) {
+	b := s.copies.Get().(*[]byte)
+	defer s.copies.Put(b)
+	for {
+		n, err := src.Read(*b)
+		if n > 0 {
+			if _, werr := dst.Write((*b)[:n]); werr != nil {
+				return
+			}
+			counted.Add(uint64(n))
+			if halfClosed.Load() {
+				src.SetReadDeadline(time.Now().Add(halfClosedTimeout))
+			}
+		}
+		if err != nil {
+			return
+		}
+	}
+}
+
+// handleUDP opens an app's UDP flow to one of the networks (a QUIC connection, a DNS query):
+// the stack's endpoint for it at once - the packet that began the flow goes into it - and the
+// direct socket next. A flow the site has not answered in answerTimeout ends, and the app's next
+// datagrams go through the VPN (detour.go). The stack calls it on its way in, so nothing here
+// may wait.
+func (s *Sorter) handleUDP(r *udp.ForwarderRequest) {
+	id := r.ID()
+	flow := flowOf(protoUDP, id)
+	if !s.detour.carry(flow) {
+		return // its way went through the VPN: this datagram is dropped, the next ones go there
+	}
+	var wq waiter.Queue
+	ep, terr := r.CreateEndpoint(&wq)
+	if terr != nil {
+		s.detour.release(flow)
+		return
+	}
+	in := gonet.NewUDPConn(s.stack, &wq, ep)
+	to := farSide(id)
+	idle := udpIdle
+	if id.LocalPort == 53 {
+		idle = dnsUDPIdle
+	}
+	go func() {
+		defer s.detour.release(flow)
+		out, err := dial(s.ctx, "udp4", to)
+		if err != nil {
+			if s.ctx.Err() == nil {
+				s.notOpened(flow)
+				s.failed.Add(1)
+			}
+			in.Close()
+			return
+		}
+		if !s.track(in, out) {
+			return
+		}
+		answered := relayUDP(in, out, idle, answerTimeout, func() {
+			s.udpOpened.Add(1)
+			s.detour.opened(flow) // a UDP flow never tries again: nothing to log
+		}, &s.rxBytes, &s.txBytes)
+		s.untrack(in, out)
+		if !answered && s.ctx.Err() == nil {
+			s.notOpened(flow)
+			s.failed.Add(1)
+		}
+	}()
+}
+
+// relayUDP carries a flow's datagrams both ways until neither way carried any for idle, or one
+// way fails, or the site has not answered within answerWithin; then closes it. answered is
+// called at the site's first datagram, and the result tells whether there was one. What it
+// carried goes to rx (the site's) and tx (the app's).
+func relayUDP(in *gonet.UDPConn, out net.Conn, idle, answerWithin time.Duration, answered func(), rx, tx *atomic.Uint64) bool {
+	var last atomic.Int64
+	last.Store(time.Now().UnixNano())
+	var got atomic.Bool
+	var once sync.Once
+	stop := func() {
+		once.Do(func() {
+			in.Close()
+			out.Close()
+		})
+	}
+	carry := func(dst, src net.Conn, fromSite bool) {
+		defer stop()
+		b := make([]byte, udpBufferSize)
+		for {
+			wait := idle
+			if fromSite && !got.Load() {
+				wait = answerWithin
+			}
+			src.SetReadDeadline(time.Now().Add(wait))
+			n, err := src.Read(b)
+			if err != nil {
+				if fromSite && !got.Load() {
+					return // no answer: the flow goes through the VPN
+				}
+				var timeout net.Error
+				if errors.As(err, &timeout) && timeout.Timeout() &&
+					time.Since(time.Unix(0, last.Load())) < idle {
+					continue // quiet this way, busy the other
+				}
+				return
+			}
+			if fromSite && !got.Load() {
+				got.Store(true)
+				answered()
+			}
+			last.Store(time.Now().UnixNano())
+			if _, err := dst.Write(b[:n]); err != nil {
+				return
+			}
+			if fromSite {
+				rx.Add(uint64(n))
+			} else {
+				tx.Add(uint64(n))
+			}
+		}
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		carry(out, in, false) // the app's datagrams to the site
+	}()
+	carry(in, out, true) // the site's to the app
+	<-done
+	return got.Load()
+}
