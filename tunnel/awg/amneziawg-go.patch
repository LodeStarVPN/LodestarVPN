+// a UDP flow that was not answered sends that address's UDP flows through the VPN for retryDirect
+// - not its TCP connections, and nothing tries it in the background
+func TestUDPAddressDoesNotHoldTCP(t *testing.T) {
+	quickHealing(t)
+	answer, retry := answerTimeout, retryDirect
+	t.Cleanup(func() { answerTimeout, retryDirect = answer, retry })
+	answerTimeout, retryDirect = 100*time.Millisecond, 400*time.Millisecond
+	r := newRig(t)
+	r.quietUDP.Store(true)
+	c, err := gonet.DialUDP(r.apps, nil, &tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFrom4(siteDirect.As4()), Port: 443}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	c.Write([]byte("initial"))
+	if !r.waitFor(func() bool { return !r.sorter.Takes(udpTo(siteDirect, 443)) }) {
+		t.Fatal("the UDP address did not go through the VPN after the site did not answer")
+	}
+	if !r.sorter.Takes(synTo(siteDirect, 443)) {
+		t.Error("a TCP connection to that address went through the VPN with its UDP flow")
+	}
+	dials := r.dials.Load()
+	time.Sleep(200 * time.Millisecond)
+	if r.dials.Load() != dials {
+		t.Error("a UDP address was tried in the background")
+	}
+	if !r.waitFor(func() bool { return r.sorter.Takes(udpTo(siteDirect, 443)) }) {
+		t.Error("the UDP address did not try directly again after retryDirect")
+	}
+}
