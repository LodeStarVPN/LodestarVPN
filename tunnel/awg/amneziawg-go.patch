@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+package device
+
+import "encoding/binary"
+
+// The apps' data the device carries for them, each way: what the speed in the app counts
+// (data_rx_bytes and data_tx_bytes in uapi.go), as the sorter counts its connections' data. A
+// peer's rx_bytes and tx_bytes are its messages: the packets' headers and what the tunnel adds to
+// each - some 4 % more than the data on a download, and the download's acknowledgements on their way
+// back twice their own size, with no data in them at all.
+
+// dataLen is the data an IP packet carries: a TCP segment's or a UDP datagram's payload, a later
+// fragment whole, what follows the IP header for anything else; 0 for what is not a whole packet.
+func dataLen(packet []byte) int {
+	if len(packet) == 0 {
+		return 0
+	}
+	switch packet[0] >> 4 {
+	case 4:
+		if len(packet) < 20 {
+			return 0
+		}
+		headerLen := int(packet[0]&0x0f) * 4
+		total := int(binary.BigEndian.Uint16(packet[2:4]))
+		if total > len(packet) {
+			total = len(packet)
+		}
+		if headerLen < 20 || headerLen > total {
+			return 0
+		}
+		// a fragment after the first has no transport header in it
+		first := binary.BigEndian.Uint16(packet[6:8])&0x1fff == 0
+		return transportDataLen(packet[9], packet[headerLen:total], first)
+	case 6:
+		if len(packet) < 40 {
+			return 0
+		}
+		total := 40 + int(binary.BigEndian.Uint16(packet[4:6]))
+		if total > len(packet) {
+			total = len(packet)
+		}
+		// (extension headers, seldom seen here, count as data)
+		return transportDataLen(packet[6], packet[40:total], true)
+	}
+	return 0
+}
+
+func transportDataLen(protocol byte, segment []byte, first bool) int {
+	if !first {
+		return len(segment)
+	}
+	switch protocol {
+	case 6: // TCP
+		if len(segment) < 20 {
+			return 0
+		}
+		headerLen := int(segment[12]>>4) * 4
+		if headerLen < 20 || headerLen > len(segment) {
+			return 0
+		}
+		return len(segment) - headerLen
+	case 17: // UDP
+		if len(segment) < 8 {
+			return 0
+		}
+		return len(segment) - 8
+	}
+	return len(segment)
+}
diff --git a/device/datacount_test.go b/device/datacount_test.go
new file mode 100755
index 0000000..fe4af5e
--- /dev/null
+++ b/device/datacount_test.go
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+package device
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net/netip"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+// an IPv4 packet: the given transport header and that much data after it
+func testIPv4(src, dst netip.Addr, protocol byte, transport []byte, data int) []byte {
+	p := make([]byte, 20+len(transport)+data)
+	p[0] = 0x45
+	binary.BigEndian.PutUint16(p[2:4], uint16(len(p)))
+	p[8] = 64
+	p[9] = protocol
+	copy(p[12:16], src.AsSlice())
+	copy(p[16:20], dst.AsSlice())
+	copy(p[20:], transport)
+	for i := 20 + len(transport); i < len(p); i++ {
+		p[i] = byte(i)
+	}
+	return p
+}
+
+// a TCP header of headerLen bytes (20, or more with options)
+func testTCP(headerLen int) []byte {
+	h := make([]byte, headerLen)
+	binary.BigEndian.PutUint16(h[0:2], 40000)
+	binary.BigEndian.PutUint16(h[2:4], 443)
+	h[12] = byte(headerLen/4) << 4
+	h[13] = 0x18 // PSH, ACK
+	return h
+}
+
+func testUDP(data int) []byte {
+	h := make([]byte, 8)
+	binary.BigEndian.PutUint16(h[0:2], 40000)
+	binary.BigEndian.PutUint16(h[2:4], 443)
+	binary.BigEndian.PutUint16(h[4:6], uint16(8+data))
+	return h
+}
+
+func TestDataLen(t *testing.T) {
+	a := netip.MustParseAddr("10.0.0.1")
+	b := netip.MustParseAddr("10.0.0.2")
+	fragment := testIPv4(a, b, 17, nil, 300)
+	binary.BigEndian.PutUint16(fragment[6:8], 185) // offset 185 × 8 bytes: a later fragment
+	ipv6 := func(next byte, transport []byte, data int) []byte {
+		p := make([]byte, 40+len(transport)+data)
+		p[0] = 0x60
+		binary.BigEndian.PutUint16(p[4:6], uint16(len(transport)+data))
+		p[6] = next
+		copy(p[40:], transport)
+		return p
+	}
+	withOptions := testIPv4(a, b, 6, testTCP(20), 100)
+	withOptions = append(withOptions[:20], append(make([]byte, 8), withOptions[20:]...)...) // IP options, 8 bytes
+	withOptions[0] = 0x47
+	binary.BigEndian.PutUint16(withOptions[2:4], uint16(len(withOptions)))
+	padded := append(testIPv4(a, b, 6, testTCP(20), 10), make([]byte, 6)...) // the tunnel's padding after it
+
+	for _, c := range []struct {
+		name   string
+		packet []byte
+		want   int
+	}{
+		{"tcp", testIPv4(a, b, 6, testTCP(20), 1360), 1360},
+		{"tcp with options", testIPv4(a, b, 6, testTCP(32), 1348), 1348},
+		{"a bare acknowledgement", testIPv4(a, b, 6, testTCP(32), 0), 0},
+		{"udp", testIPv4(a, b, 17, testUDP(1200), 1200), 1200},
+		{"icmp", testIPv4(a, b, 1, make([]byte, 8), 56), 64},
+		{"a later fragment", fragment, 300},
+		{"ip options", withOptions, 100},
+		{"padding after the packet", padded, 10},
+		{"tcp6", ipv6(6, testTCP(20), 1220), 1220},
+		{"udp6", ipv6(17, testUDP(1000), 1000), 1000},
+		{"short ip header", testIPv4(a, b, 6, nil, 0)[:19], 0},
+		{"tcp header cut", testIPv4(a, b, 6, nil, 10), 0},
+		{"tcp data offset too large", testIPv4(a, b, 6, append(testTCP(20)[:12], 0xf0, 0, 0, 0, 0, 0, 0, 0), 4), 0},
+		{"ip header length too small", append([]byte{0x44}, testIPv4(a, b, 6, testTCP(20), 5)[1:]...), 0},
+		{"no packet", nil, 0},
+		{"another version", []byte{0x50, 1, 2, 3}, 0},
+	} {
+		if got := dataLen(c.packet); got != c.want {
+			t.Errorf("%s: %d, want %d", c.name, got, c.want)
+		}
+	}
+}
+
+func testDataCounts(t *testing.T, dev *Device) (rx, tx uint64) {
+	t.Helper()
+	var get strings.Builder
+	if err := dev.IpcGetOperation(&get); err != nil {
+		t.Fatal(err)
+	}
+	seen := 0
+	for _, line := range strings.Split(get.String(), "\n") {
+		if v, ok := strings.CutPrefix(line, "data_rx_bytes="); ok {
+			rx, _ = strconv.ParseUint(v, 10, 64)
+			seen++
+		}
+		if v, ok := strings.CutPrefix(line, "data_tx_bytes="); ok {
+			tx, _ = strconv.ParseUint(v, 10, 64)
+			seen++
+		}
+	}
+	if seen != 2 {
+		t.Fatalf("data_rx_bytes and data_tx_bytes not told: %q", get.String())
+	}
+	return
+}
+
+// Through a peer: the sender counts the data it sends, the receiver the data it got, the headers
+// and what the tunnel adds not at all.
+func TestDataCountsThroughPeer(t *testing.T) {
+	pair := genTestPair(t, false)
+	// the handshake first, with a ping each way
+	pair.Send(t, Ping, nil)
+	pair.Send(t, Pong, nil)
+	rx0, _ := testDataCounts(t, pair[0].dev)
+	_, tx1 := testDataCounts(t, pair[1].dev)
+
+	packets := [][]byte{
+		testIPv4(pair[1].ip, pair[0].ip, 6, testTCP(32), 1000),
+		testIPv4(pair[1].ip, pair[0].ip, 6, testTCP(32), 0),
+		testIPv4(pair[1].ip, pair[0].ip, 17, testUDP(300), 300),
+	}
+	for _, p := range packets {
+		pair[1].tun.Outbound <- p
+		select {
+		case got := <-pair[0].tun.Inbound:
+			if !bytes.Equal(got, p) {
+				t.Fatalf("a packet did not transit whole")
+			}
+		case <-time.After(6 * time.Second):
+			t.Fatal("a packet did not transit")
+		}
+	}
+	rx, _ := testDataCounts(t, pair[0].dev)
+	_, tx := testDataCounts(t, pair[1].dev)
+	if rx-rx0 != 1300 || tx-tx1 != 1300 {
+		t.Errorf("received %d, sent %d of 1300 bytes of data", rx-rx0, tx-tx1)
+	}
+}
