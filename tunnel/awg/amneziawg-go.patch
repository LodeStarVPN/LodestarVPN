index 0000000..75da27b
--- /dev/null
+++ b/device/sorter_test.go
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+package device
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/netip"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn/bindtest"
+	"github.com/amnezia-vpn/amneziawg-go/v3/sorter"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun/tuntest"
+)
+
+// an IPv4 address of this machine that is not loopback: the apps' stack does not send to 127/8
+func localIPv4(t *testing.T) netip.Addr {
+	ifaces, _ := net.Interfaces()
+	for _, iface := range ifaces {
+		if iface.Flags&net.FlagUp == 0 || iface.Flags&net.FlagLoopback != 0 {
+			continue
+		}
+		addrs, _ := iface.Addrs()
+		for _, a := range addrs {
+			if n, ok := a.(*net.IPNet); ok {
+				if ip, ok := netip.AddrFromSlice(n.IP.To4()); ok && n.IP.To4() != nil {
+					return ip
+				}
+			}
+		}
+	}
+	t.Skip("no IPv4 address but loopback")
+	return netip.Addr{}
+}
+
+// The device takes the direct_network lines of its settings: a connection to such an address
+// goes through the device's read path into the sorter and on to the site by this machine's own
+// network, and the answers come back through the tunnel device.
+func TestDirectNetworks(t *testing.T) {
+	site := localIPv4(t)
+	listener, err := net.Listen("tcp4", net.JoinHostPort(site.String(), "0"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	go func() {
+		for {
+			c, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				io.Copy(c, c)
+				c.Close()
+			}()
+		}
+	}()
+	port := uint16(listener.Addr().(*net.TCPAddr).Port)
+
+	// the test's own network is not a VPN's: nothing to keep its sockets out of
+	sorter.SetDialControl(func(network, address string, c syscall.RawConn) error { return nil })
+	defer sorter.SetDialControl(nil)
+
+	tunDev := tuntest.NewChannelTUN()
+	binds := bindtest.NewChannelBinds()
+	dev := NewDevice(tunDev.TUN(), binds[0], NewLogger(LogLevelError, "dev: "))
+	defer dev.Close()
+	if err := dev.IpcSet("direct_network=" + site.String() + "/32\ndirect_network=198.18.0.0/15\n"); err != nil {
+		t.Fatal(err)
+	}
+	if dev.direct.Load() == nil {
+		t.Fatal("no sorter after direct_network lines")
+	}
+	if err := dev.Up(); err != nil {
+		t.Fatal(err)
+	}
+
+	// the apps: a gVisor stack on the channel tunnel device
+	apps := stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol},
+	})
+	defer apps.Close()
+	mtu, _ := tunDev.TUN().MTU()
+	ep := channel.New(256, uint32(mtu), "")
+	if err := apps.CreateNIC(1, ep); err != nil {
+		t.Fatal(err)
+	}
+	apps.AddProtocolAddress(1, tcpip.ProtocolAddress{
+		Protocol:          ipv4.ProtocolNumber,
+		AddressWithPrefix: tcpip.AddrFrom4([4]byte{10, 9, 0, 2}).WithPrefix(),
+	}, stack.AddressProperties{})
+	apps.AddRoute(tcpip.Route{Destination: header.IPv4EmptySubnet, NIC: 1})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go func() {
+		for {
+			pkt := ep.ReadContext(ctx)
+			if pkt.IsNil() {
+				return
+			}
+			b := pkt.ToView().AsSlice()
+			pkt.DecRef()
+			select {
+			case tunDev.Outbound <- b:
+			case <-ctx.Done():
+				return
+			}
+		}
+	}()
+	go func() {
+		for {
+			select {
+			case b, ok := <-tunDev.Inbound:
+				if !ok {
+					return
+				}
+				pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(b)})
+				ep.InjectInbound(header.IPv4ProtocolNumber, pkt)
+				pkt.DecRef()
+			case <-ctx.Done():
+				return
+			}
+		}
+	}()
+
+	dialCtx, dialCancel := context.WithTimeout(ctx, 5*time.Second)
+	defer dialCancel()
+	c, err := gonet.DialContextTCP(dialCtx, apps, tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFrom4(site.As4()), Port: port}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatalf("connect to %v:%d through the device: %v", site, port, err)
+	}
+	defer c.Close()
+	msg := []byte("through the device's own network")
+	c.Write(msg)
+	got := make([]byte, len(msg))
+	c.SetReadDeadline(time.Now().Add(5 * time.Second))
+	if _, err := io.ReadFull(c, got); err != nil || string(got) != string(msg) {
+		t.Fatalf("echo %q, %v", got, err)
+	}
+
+	// settings: an IPv6 network is refused; replace_direct_networks alone stops the sorter
+	if err := dev.IpcSet("direct_network=2001:db8::/32\n"); err == nil {
+		t.Error("an IPv6 direct_network was taken")
+	}
+	if err := dev.IpcSet("direct_network=10.0.0.0/33\n"); err == nil {
+		t.Error("a bad direct_network was taken")
+	}
+	if dev.direct.Load() == nil {
+		t.Error("a refused setting stopped the sorter")
+	}
+	if err := dev.IpcSet("replace_direct_networks=true\n"); err != nil {
+		t.Fatal(err)
+	}
+	if dev.direct.Load() != nil {
+		t.Error("the sorter lives on after replace_direct_networks")
+	}
+	t.Logf("site %v:%s", site, strconv.Itoa(int(port)))
+}
