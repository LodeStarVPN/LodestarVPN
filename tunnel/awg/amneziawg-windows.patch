new file mode 100644
index 0000000..89b57e1
--- /dev/null
+++ b/directroute.go
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 LodestarVPN. All Rights Reserved.
+ */
+
+package main
+
+import (
+	"log"
+	"sync"
+	"time"
+
+	"golang.org/x/sys/windows"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/sorter"
+	"github.com/amnezia-vpn/amneziawg-windows/v3/tunnel/winipcfg"
+)
+
+// directRoute keeps the sorter's direct sockets (amneziawg-go/sorter: the networks the app sends
+// past the VPN) on the computer's own network: they are bound to the interface of the best
+// default route that is not the tunnel's, and that follows the network as it changes (Wi-Fi,
+// cable, none).
+type directRoute struct {
+	ours     winipcfg.LUID
+	mu       sync.Mutex
+	last     uint32
+	timer    *time.Timer
+	callback *winipcfg.RouteChangeCallback
+}
+
+func followDirectRoute(tunnelLUID uint64) (*directRoute, error) {
+	d := &directRoute{ours: winipcfg.LUID(tunnelLUID), last: ^uint32(0)}
+	d.update()
+	d.timer = time.AfterFunc(time.Hour, d.update)
+	d.timer.Stop()
+	var err error
+	d.callback, err = winipcfg.RegisterRouteChangeCallback(func(notificationType winipcfg.MibNotificationType, route *winipcfg.MibIPforwardRow2) {
+		if route != nil && route.DestinationPrefix.PrefixLength == 0 {
+			// a burst of changes comes to one look
+			d.timer.Reset(150 * time.Millisecond)
+		}
+	})
+	return d, err
+}
+
+func (d *directRoute) update() {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	index := bestDefaultInterface4(d.ours)
+	sorter.SetInterface4(index)
+	if index != d.last {
+		log.Printf("Direct connections leave by interface %d", index)
+		d.last = index
+	}
+}
+
+func (d *directRoute) close() {
+	if d.callback != nil {
+		d.callback.Unregister()
+	}
+	d.timer.Stop()
+	sorter.SetInterface4(0)
+}
+
+// bestDefaultInterface4 is the index of the interface whose IPv4 default route the system would
+// take if the tunnel were not there (0: none), the way the WireGuard service picks the one for
+// its own socket.
+func bestDefaultInterface4(ours winipcfg.LUID) uint32 {
+	routes, err := winipcfg.GetIPForwardTable2(windows.AF_INET)
+	if err != nil {
+		return 0
+	}
+	lowest := ^uint32(0)
+	index := uint32(0)
+	for i := range routes {
+		r := &routes[i]
+		if r.DestinationPrefix.PrefixLength != 0 || r.InterfaceLUID == ours {
+			continue
+		}
+		row, err := r.InterfaceLUID.Interface()
+		if err != nil || row.OperStatus != winipcfg.IfOperStatusUp {
+			continue
+		}
+		iface, err := r.InterfaceLUID.IPInterface(windows.AF_INET)
+		if err != nil {
+			continue
+		}
+		if r.Metric+iface.Metric < lowest {
+			lowest = r.Metric + iface.Metric
+			index = r.InterfaceIndex
+		}
+	}
+	return index
+}
